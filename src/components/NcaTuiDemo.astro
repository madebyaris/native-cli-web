---
/**
 * Interactive HTML demo of the nca full-screen TUI (browser-only, not the real binary).
 * Reflects v0.5: live busy activity, /connect, /todos, product-home paths.
 */
---

<div class="relative">
  <div
    id="nca-tui-demo"
    class="nca-tui-demo relative overflow-hidden border border-white/[0.14] bg-[#0a0b09] text-left"
    role="region"
    aria-label="Interactive nca TUI demo"
    tabindex="-1"
  >
    <div
      class="grid min-h-[280px] grid-cols-1 gap-px border-b border-white/[0.08] bg-white/[0.08] md:min-h-[300px] md:grid-cols-[1fr_min(38%,280px)]"
    >
      <div class="flex min-h-0 flex-col bg-[#0e0f0c]">
        <div class="border-b border-white/[0.08] px-3 py-2 font-mono text-[10px] leading-tight text-[#8f8a7e] md:text-[11px]">
          transcript — <span data-demo-line-count>1</span> lines (↑↓ wheel · End bottom)
        </div>
        <div
          class="demo-transcript scrollbar-thin max-h-[180px] flex-1 overflow-y-auto px-3 py-2 font-mono text-[11px] leading-relaxed md:max-h-[220px] md:text-[12px]"
        >
          <p class="mb-2 text-[#ff5c1c]">
            ▶ Interactive run — type a message, Tab cycles agent, Ctrl+P opens commands.
          </p>
          <div data-demo-transcript-append class="space-y-2 text-[#d9d4c7]"></div>
        </div>
        <div
          class="border-t border-white/[0.08] px-3 py-1.5 font-mono text-[9px] text-[#7d786c] md:text-[10px]"
          data-demo-busy-footer
          aria-live="polite"
        >
          idle · ready for input
        </div>
      </div>

      <aside class="flex flex-col border-t border-white/[0.08] bg-[#0a0b09] md:border-t-0 md:border-l">
        <div
          class="border-b border-white/[0.08] px-2 py-1.5 font-mono text-[10px] font-medium tracking-wide text-[#a8a296] uppercase"
        >
          Context
        </div>
        <div class="space-y-0.5 px-2 py-2 font-mono text-[10px] leading-snug text-[#cfcabd] md:text-[11px]">
          <div><span class="text-[#7d786c]">workspace</span> ~/project</div>
          <div><span class="text-[#7d786c]">model</span> <span class="text-[#efece4]">MiniMax-M2.7</span></div>
          <div>
            <span class="text-[#7d786c]">agent</span>
            <span data-demo-agent class="text-[#ff5c1c]">@build</span>
          </div>
          <div><span class="text-[#7d786c]">mode</span> AcceptEdits</div>
          <div>
            <span class="text-[#7d786c]">status</span>
            <span data-demo-status class="text-[#7dcea0]">idle</span>
          </div>
          <div><span class="text-[#7d786c]">blocks</span> <span data-demo-blocks>1</span></div>
        </div>
        <div
          class="border-t border-white/[0.08] px-2 py-1.5 font-mono text-[10px] font-medium tracking-wide text-[#a8a296] uppercase"
        >
          Usage
        </div>
        <div class="space-y-0.5 px-2 py-2 font-mono text-[10px] text-[#cfcabd] md:text-[11px]">
          <div>
            input <span data-demo-tok-in>0</span> · output <span data-demo-tok-out>0</span> · total
            <span data-demo-tok-total>0</span>
          </div>
          <div>cost <span class="text-[#a8a296]">$0.0000</span></div>
        </div>
        <div
          class="border-t border-white/[0.08] px-2 py-1.5 font-mono text-[10px] font-medium tracking-wide text-[#a8a296] uppercase"
        >
          Home
        </div>
        <div class="flex-1 px-2 py-2 font-mono text-[10px] text-[#cfcabd] md:text-[11px]">
          <div class="text-[#7d786c]">product home</div>
          <div class="mb-2 text-[#efece4]">~/.local/share/ncacli/</div>
          <div class="text-[#7d786c]">sessions</div>
          <div class="text-[#efece4]">workspaces/…/sessions/</div>
          <div class="mt-2 text-[#7d786c]">Ctrl+P · /connect · /todos</div>
        </div>
      </aside>
    </div>

    <div
      class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-white/[0.08] bg-[#0c0d0a] px-3 py-2 font-mono text-[10px] md:text-[11px]"
    >
      <img
        data-demo-robot
        src="/images/nca-robot.png"
        alt="nca robot"
        width="64"
        height="64"
        class="h-6 w-6 [image-rendering:pixelated]"
      />
      <span class="inline-flex items-center gap-1.5" data-demo-status-pill>
        <span class="h-1.5 w-1.5 rounded-full bg-[#7dcea0]" data-demo-status-dot aria-hidden="true"></span>
        <span data-demo-status-label class="text-[#7dcea0]">idle</span>
      </span>
      <span class="text-[#efece4]">MiniMax-M2.7</span>
      <span data-demo-agent-status class="text-[#ff5c1c]">@build</span>
      <span class="text-[#a8a296]">perm:AcceptEdits</span>
      <span data-demo-timer class="ml-auto tabular-nums text-[#a8a296]">00:00</span>
    </div>

    <div class="bg-[#0e0f0c] px-3 py-2">
      <div class="mb-1 font-mono text-[10px] text-[#7d786c]">message</div>
      <div class="flex items-center gap-2 border border-white/[0.14] bg-[#0a0b09] px-2 py-1.5">
        <span class="shrink-0 font-mono text-[#ff5c1c]">❯</span>
        <input
          type="text"
          data-demo-input
          class="demo-input min-w-0 flex-1 bg-transparent font-mono text-[12px] text-[#efece4] outline-none placeholder:text-[#5d594f] md:text-[13px]"
          placeholder="Try Tab, Ctrl+P, Enter…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Demo message input"
        />
      </div>
    </div>

    <div
      data-demo-palette
      class="pointer-events-none invisible absolute inset-0 z-10 flex items-start justify-center bg-black/50 p-4 opacity-0 transition-opacity duration-150"
      aria-hidden="true"
    >
      <div
        class="pointer-events-auto mt-6 w-full max-w-sm border border-white/[0.14] bg-[#171815] p-2 font-mono text-[11px]"
        role="dialog"
        aria-modal="true"
        aria-label="Command palette"
      >
        <div class="mb-2 px-2 py-1 text-[10px] text-[#7d786c]">Commands (Enter runs)</div>
        <ul class="space-y-0.5" role="listbox">
          <li>
            <button type="button" data-demo-cmd="/connect" class="w-full px-2 py-1.5 text-left text-[#efece4] hover:bg-white/[0.06]">
              /connect — provider, key, custom endpoint
            </button>
          </li>
          <li>
            <button type="button" data-demo-cmd="/todos" class="w-full px-2 py-1.5 text-left text-[#efece4] hover:bg-white/[0.06]">
              /todos — session todo list
            </button>
          </li>
          <li>
            <button type="button" data-demo-cmd="/status" class="w-full px-2 py-1.5 text-left text-[#efece4] hover:bg-white/[0.06]">
              /status — session health
            </button>
          </li>
          <li>
            <button type="button" data-demo-cmd="/image clear" class="w-full px-2 py-1.5 text-left text-[#efece4] hover:bg-white/[0.06]">
              /image clear
            </button>
          </li>
        </ul>
        <p class="mt-2 px-2 text-[10px] text-[#7d786c]">Esc to close</p>
      </div>
    </div>
  </div>

  <p class="font-ui mt-3 text-center text-[11px] text-fg-muted">
    Interactive demo — <kbd class="bg-surface-400 px-1 font-mono text-[10px]">Tab</kbd> cycles agent ·
    <kbd class="bg-surface-400 px-1 font-mono text-[10px]">Ctrl</kbd>+<kbd
      class="bg-surface-400 px-1 font-mono text-[10px]">P</kbd
    >
    command palette · <kbd class="bg-surface-400 px-1 font-mono text-[10px]">Enter</kbd> sends (no model)
  </p>
</div>

<script>
  const AGENTS = ["@build", "@plan", "@review", "@fix", "@test"];

  function init() {
    const root = document.getElementById("nca-tui-demo");
    if (!root || root.dataset.ready === "1") return;
    root.dataset.ready = "1";

    const input = root.querySelector("[data-demo-input]");
    const append = root.querySelector("[data-demo-transcript-append]");
    const palette = root.querySelector("[data-demo-palette]");
    const agentEls = root.querySelectorAll("[data-demo-agent], [data-demo-agent-status]");
    const lineCountEl = root.querySelector("[data-demo-line-count]");
    const blocksEl = root.querySelector("[data-demo-blocks]");
    const tokIn = root.querySelector("[data-demo-tok-in]");
    const tokOut = root.querySelector("[data-demo-tok-out]");
    const tokTotal = root.querySelector("[data-demo-tok-total]");
    const timerEl = root.querySelector("[data-demo-timer]");
    const statusEls = root.querySelectorAll("[data-demo-status], [data-demo-status-label]");
    const statusDot = root.querySelector("[data-demo-status-dot]");
    const busyFooter = root.querySelector("[data-demo-busy-footer]");
    const firstCmd = palette?.querySelector<HTMLButtonElement>("[data-demo-cmd]");

    if (!input || !append) return;
    const inputEl = input as HTMLInputElement;
    const transcriptAppend = append;

    let agentIdx = 0;
    let lineCount = 1;
    let blockCount = 1;
    let sec = 0;
    let tokInN = 0;
    let tokOutN = 0;
    let busy = false;

    function setAgent() {
      const a = AGENTS[agentIdx] ?? "@build";
      agentEls.forEach((el) => {
        el.textContent = a;
      });
    }

    function setBusy(next: boolean, label = "thinking") {
      busy = next;
      const text = next ? `${label} ${Math.max(1, sec % 20)}s` : "idle";
      statusEls.forEach((el) => {
        el.textContent = text;
        el.classList.toggle("text-[#ff8a55]", next);
        el.classList.toggle("text-[#7dcea0]", !next);
      });
      if (statusDot instanceof HTMLElement) {
        statusDot.classList.toggle("bg-[#ff8a55]", next);
        statusDot.classList.toggle("bg-[#7dcea0]", !next);
      }
      if (busyFooter) {
        busyFooter.textContent = next
          ? `${label} ${Math.max(1, sec % 20)}s · tool path preview in real binary`
          : "idle · ready for input";
      }
      const robot = root?.querySelector("[data-demo-robot]");
      if (robot instanceof HTMLImageElement) {
        robot.src = next ? "/images/nca-robot-blink.png" : "/images/nca-robot.png";
      }
    }

    function openPalette() {
      if (!palette) return;
      palette.classList.remove("invisible", "pointer-events-none", "opacity-0");
      palette.setAttribute("aria-hidden", "false");
      firstCmd?.focus();
    }

    function closePalette() {
      if (!palette) return;
      palette.classList.add("invisible", "pointer-events-none", "opacity-0");
      palette.setAttribute("aria-hidden", "true");
      inputEl.focus();
    }

    function appendLine(role: "user" | "assistant", text: string) {
      const wrap = document.createElement("div");
      if (role === "user") {
        wrap.className = "text-[#efece4]";
        wrap.textContent = `you › ${text}`;
      } else {
        wrap.className = "text-[#b7b2a6]";
        wrap.textContent = `nca › ${text}`;
      }
      transcriptAppend.appendChild(wrap);
      lineCount += 1;
      blockCount += 1;
      if (lineCountEl) lineCountEl.textContent = String(lineCount);
      if (blocksEl) blocksEl.textContent = String(blockCount);
      const scrollEl = transcriptAppend.parentElement;
      if (scrollEl) scrollEl.scrollTo({ top: scrollEl.scrollHeight, behavior: "smooth" });
    }

    function bumpTokens(inN: number, outN: number) {
      tokInN += inN;
      tokOutN += outN;
      if (tokIn) tokIn.textContent = String(tokInN);
      if (tokOut) tokOut.textContent = String(tokOutN);
      if (tokTotal) tokTotal.textContent = String(tokInN + tokOutN);
    }

    inputEl.addEventListener("keydown", (e) => {
      if (e.key === "Tab") {
        e.preventDefault();
        agentIdx = (agentIdx + 1) % AGENTS.length;
        setAgent();
        return;
      }
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "p") {
        e.preventDefault();
        openPalette();
        return;
      }
      if (e.key === "Escape" && palette && !palette.classList.contains("invisible")) {
        e.preventDefault();
        closePalette();
        return;
      }
      if (e.key === "Enter") {
        e.preventDefault();
        const v = inputEl.value.trim();
        if (!v) return;
        appendLine("user", v);
        bumpTokens(Math.min(32, v.length * 2), 0);
        inputEl.value = "";
        setBusy(true, "thinking");
        const replies = [
          "(demo) Acknowledged — real nca streams tools with busy timers.",
          "(demo) Try Tab to switch agent profile.",
          "(demo) Ctrl+P opens /connect, /todos, /status.",
        ];
        const r = replies[Math.floor(Math.random() * replies.length)]!;
        window.setTimeout(() => {
          setBusy(true, "streaming");
          window.setTimeout(() => {
            appendLine("assistant", r);
            bumpTokens(0, r.length);
            setBusy(false);
          }, 320);
        }, 280);
      }
    });

    root.querySelectorAll("[data-demo-cmd]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const t = btn.getAttribute("data-demo-cmd") ?? "";
        inputEl.value = t;
        closePalette();
      });
    });

    palette?.addEventListener("click", (e) => {
      if (e.target === palette) closePalette();
    });

    window.setInterval(() => {
      sec += 1;
      if (timerEl) {
        const m = Math.floor(sec / 60);
        const s = sec % 60;
        timerEl.textContent = `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
      }
      if (busy) setBusy(true, statusEls[0]?.textContent?.startsWith("streaming") ? "streaming" : "thinking");
    }, 1000);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && palette && !palette.classList.contains("invisible")) {
        closePalette();
      }
    });
  }

  init();
</script>

<style is:global>
  .nca-tui-demo .demo-input::placeholder {
    color: rgb(75 85 99);
  }
</style>
