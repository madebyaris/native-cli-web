---
import { NCA_VERSION, GITHUB_REPO } from "../consts";

interface Props {
  active?: "home" | "install" | "docs" | "support";
}

const { active } = Astro.props;

const nav = [
  { href: "/#features", label: "Features", key: undefined },
  { href: "/#whats-new", label: "What's New", key: undefined },
  { href: "/get-started", label: "Install", key: "install" as const },
  { href: "/docs", label: "Documentation", key: "docs" as const },
  { href: "/support", label: "Support", key: "support" as const },
];

const linkClass = (key: typeof active | undefined) =>
  key && active === key
    ? "text-fg border-b border-fg font-medium"
    : "text-fg-muted hover:text-accent-hover border-b border-transparent transition-colors duration-150";
---

<header class="site-header sticky top-0 z-[70]">
  <div
    class="site-header-bar relative border-b border-border bg-page/90 backdrop-blur-md"
  >
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
      <div class="flex items-center gap-3">
        <a href="/" class="font-display text-lg font-semibold tracking-tight text-fg" translate="no">nca</a>
        <a
          href={`${GITHUB_REPO}/releases/tag/v${NCA_VERSION}`}
          class="font-ui hidden rounded-pill border border-border bg-surface-300 px-2 py-0.5 text-[11px] font-medium text-fg-muted transition-colors hover:border-border-strong hover:text-fg sm:inline-flex"
          target="_blank"
          rel="noopener noreferrer"
        >
          v{NCA_VERSION}
        </a>
      </div>

      <nav class="font-ui hidden items-center gap-7 text-sm md:flex" aria-label="Primary">
        {
          nav.map((item) => (
            <a href={item.href} class:list={[linkClass(item.key), "pb-0.5"]}>
              {item.label}
            </a>
          ))
        }
        <a
          href={GITHUB_REPO}
          class="text-fg-muted hover:text-accent-hover border-b border-transparent pb-0.5 transition-colors duration-150"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="/get-started"
          class="font-ui hidden rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white shadow-md shadow-accent/25 transition-colors hover:bg-accent-hover hover:shadow-lg hover:shadow-accent/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:inline-flex"
        >
          Install
        </a>

        <button
          type="button"
          id="mobile-nav-toggle"
          class="mobile-nav-toggle font-ui inline-flex h-10 w-10 items-center justify-center rounded-md border border-border bg-page text-fg md:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          aria-label="Open menu"
        >
          <span class="mobile-nav-icon" aria-hidden="true">
            <span class="mobile-nav-icon-bar"></span>
            <span class="mobile-nav-icon-bar"></span>
            <span class="mobile-nav-icon-bar"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

{/* Outside the blurred header so position:fixed is viewport-relative */}
<div
  id="mobile-nav-panel"
  class="mobile-nav-panel font-ui"
  hidden
  inert
  aria-hidden="true"
>
  <nav class="mobile-nav-sheet" aria-label="Mobile">
    <div class="mobile-nav-sheet-inner">
      <p class="mobile-nav-eyebrow">Navigate</p>
      <div class="mobile-nav-links">
        {
          nav.map((item, i) => (
            <a
              href={item.href}
              class:list={["mobile-nav-link", item.key && active === item.key ? "is-active" : ""]}
              style={`--i: ${i}`}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={GITHUB_REPO}
          class="mobile-nav-link"
          style={`--i: ${nav.length}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </div>
      <a href="/get-started" class="mobile-nav-cta" style={`--i: ${nav.length + 1}`}>
        Install nca
      </a>
    </div>
  </nav>
</div>

<script>
  const header = document.querySelector(".site-header");
  const btn = document.getElementById("mobile-nav-toggle");
  const panel = document.getElementById("mobile-nav-panel");

  let closeTimer = 0;

  function setOpen(open: boolean) {
    if (!btn || !panel || !header) return;

    window.clearTimeout(closeTimer);
    header.classList.toggle("is-nav-open", open);

    if (open) {
      panel.hidden = false;
      panel.inert = false;
      // Reflow so the opacity/transform transition starts from closed styles.
      void panel.offsetHeight;
      panel.classList.add("is-visible");
    } else {
      panel.classList.remove("is-visible");
      panel.inert = true;
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      closeTimer = window.setTimeout(
        () => {
          if (!header.classList.contains("is-nav-open")) panel.hidden = true;
        },
        prefersReduced ? 0 : 380,
      );
    }

    panel.setAttribute("aria-hidden", String(!open));
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.documentElement.classList.toggle("overflow-hidden", open);
    document.body.classList.toggle("overflow-hidden", open);
  }

  if (btn && panel && header && btn.dataset.navBound !== "1") {
    btn.dataset.navBound = "1";

    btn.addEventListener("click", () => {
      setOpen(!header.classList.contains("is-nav-open"));
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && header.classList.contains("is-nav-open")) {
        setOpen(false);
        btn.focus();
      }
    });

    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
