---
import { GITHUB_REPO, NCA_VERSION, SPONSOR_GITHUB } from "../consts";
---

<footer class="mt-auto border-t border-border bg-page">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-10 md:flex-row md:items-end md:justify-between md:px-6">
    <div class="flex items-end gap-3">
      <img
        src="/images/nca-robot.png"
        alt="nca robot"
        width="512"
        height="512"
        class="h-12 w-12 [image-rendering:pixelated]"
        decoding="async"
      />
      <div>
      <p class="font-display text-3xl tracking-tight text-fg" translate="no">nca</p>
      <p class="font-mono-article mt-2 text-xs text-fg-muted">
        v{NCA_VERSION} · one binary · MIT
      </p>
      </div>
    </div>
    <nav class="font-ui flex flex-wrap gap-x-8 gap-y-3 text-sm" aria-label="Footer">
      <a href="/docs" class="text-fg-muted hover:text-accent-hover">Documentation</a>
      <a href="/docs/overview" class="text-fg-muted hover:text-accent-hover">Overview</a>
      <a href="/get-started" class="text-fg-muted hover:text-accent-hover">Install</a>
      <a href="/docs/advanced" class="text-fg-muted hover:text-accent-hover">Orchestration</a>
      <a href={GITHUB_REPO} class="text-fg-muted hover:text-accent-hover" target="_blank" rel="noopener noreferrer"
        >GitHub</a
      >
      <a
        href={`${GITHUB_REPO}/releases`}
        class="text-fg-muted hover:text-accent-hover"
        target="_blank"
        rel="noopener noreferrer"
      >
        Releases
      </a>
      <a href="/support" class="text-fg-muted hover:text-accent-hover">Support</a>
      <a href={SPONSOR_GITHUB} class="text-fg-muted hover:text-accent-hover" target="_blank" rel="noopener noreferrer"
        >Sponsor</a
      >
    </nav>
  </div>
  <div class="border-t border-border">
    <p class="font-ui mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-1 px-4 py-4 text-xs text-fg-muted md:px-6">
      <span>&copy; 2026 <a href="https://github.com/madebyaris" class="underline hover:text-accent-hover" target="_blank" rel="noopener noreferrer">Aris Setia</a></span>
      <span aria-hidden="true" class="hidden md:inline">·</span>
      <span>Sponsored by <a href="/support" class="underline hover:text-accent-hover">Cursor, SpaceXAI, and Kenari</a></span>
    </p>
  </div>
</footer>
