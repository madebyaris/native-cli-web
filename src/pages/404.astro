---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Page not found on nca-cli.com | Native CLI AI"
  description="This web address is not a page on nca-cli.com. Install the terminal AI coding agent, browse the full documentation, or return to the home page."
>
  <SiteHeader />
  <main id="main-content" class="flex flex-1 items-center border-b border-border">
    <div class="mx-auto max-w-xl px-4 py-24 text-center md:px-6">
      <picture class="mx-auto block h-32 w-32 [image-rendering:pixelated]">
        <source type="image/webp" srcset="/images/nca-robot.webp" />
        <img
          src="/images/nca-robot.png"
          alt="nca pixel robot mascot with one orange eye, looking for a page that is not here"
          width="512"
          height="512"
          class="h-full w-full"
          decoding="async"
        />
      </picture>
      <p class="font-ui mt-6 text-xs font-medium uppercase tracking-[0.2em] text-fg-muted">404</p>
      <h1 class="font-display mt-4 text-4xl tracking-[-0.04rem] text-fg text-balance">Page not found</h1>
      <p class="font-body mt-4 text-fg-muted">
        That URL is not on this site. nca is a Rust-native terminal AI coding agent. Use the links below to install it,
        read the docs, or return to the product overview.
      </p>
      <h2 class="font-display mt-10 text-xl text-fg">Helpful links</h2>
      <ul class="font-ui mt-4 space-y-2 text-sm text-fg-muted">
        <li>
          <a href="/" class="text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover">Home</a>
          — product overview and interactive TUI demo
        </li>
        <li>
          <a href="/docs/" class="text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover"
            >Documentation</a
          >
          — commands, sessions, providers, and orchestration
        </li>
        <li>
          <a
            href="/get-started/"
            class="text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover">Install</a
          >
          — one-line install for macOS and Linux, Windows releases
        </li>
        <li>
          <a
            href="/support/"
            class="text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover">Support</a
          >
          — sponsor the project or contribute
        </li>
      </ul>
      <div class="font-ui mt-10 flex flex-wrap items-center justify-center gap-4 text-sm">
        <a
          href="/"
          class="rounded-md bg-accent px-5 py-2.5 font-semibold text-page hover:bg-accent-hover"
        >
          Home
        </a>
        <a href="/docs/" class="font-medium text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover"
          >Documentation</a
        >
        <a
          href="/get-started/"
          class="font-medium text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover"
          >Install</a
        >
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
