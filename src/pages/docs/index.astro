---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { SITE_URL } from "../../consts";
import { docGroups } from "../../lib/doc-groups";

const entries = await getCollection("docs");
const sorted = [...entries].sort((a, b) => a.data.sidebarOrder - b.data.sidebarOrder);
const overview = sorted.find((e) => e.id === "overview") ?? sorted[0];

const breadcrumbs = {
  "@type": "BreadcrumbList",
  "@id": `${SITE_URL}/docs#breadcrumb`,
  itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Documentation", item: `${SITE_URL}/docs/` },
  ],
};
---

<DocsLayout
  title="Documentation hub | nca terminal AI coding agent"
  description="Guides for installing nca and for commands, sessions, tools, providers, desktop clients, permissions, and the interactive full-screen terminal."
  entries={entries}
  jsonLdExtra={[breadcrumbs]}
>
  <div class="prose-docs">
    <div class="flex items-center gap-4">
      <img
        src="/images/nca-robot.png"
        alt="nca robot"
        width="512"
        height="512"
        class="h-14 w-14 [image-rendering:pixelated]"
        decoding="async"
      />
      <h1 class="font-display m-0 text-4xl tracking-[-0.04rem] text-fg text-balance md:text-[2.35rem]">Documentation</h1>
    </div>
    <p class="mt-3 text-fg">
      Guides mirrored from the{" "}
      <a
        href="https://github.com/madebyaris/native-cli-ai/tree/main/docs/documentation"
        class="font-medium text-accent underline decoration-accent/35 underline-offset-[3px] hover:text-accent-hover"
        target="_blank"
        rel="noopener noreferrer"
      >
        native-cli-ai repository
      </a>
      . Start with Overview.
    </p>

    {
      docGroups.map((group) => {
        const items = group.ids.flatMap((id) => {
          const entry = sorted.find((item) => item.id === id);
          return entry ? [entry] : [];
        });
        return (
          <section class="mt-10">
            <h2 class="font-display text-2xl tracking-tight text-fg">{group.label}</h2>
            <ul class="mt-4 list-none space-y-3 p-0">
              {items.map((entry) => (
                <li class="border border-border bg-surface-400/40 transition-colors hover:border-border-strong">
                  <a
                    href={`/docs/${entry.id}/`}
                    class="font-ui flex flex-col gap-1 px-4 py-4 no-underline md:flex-row md:items-center md:justify-between"
                  >
                    <span class="text-base font-medium text-fg">{entry.data.title}</span>
                    {entry.data.description && (
                      <span class="text-sm text-fg-muted md:max-w-md md:text-right">{entry.data.description}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }

    <h2 class="font-display mt-12 text-2xl tracking-tight text-fg">Suggested path</h2>
    <p class="mt-3 text-fg">
      New users should install from <a href="/get-started/">Get started</a>, then read
      <a href="/docs/getting-started/">Getting Started</a>, <a href="/docs/interactive-mode/">Interactive Mode</a>, and
      <a href="/docs/providers/">Providers</a>. Desktop clients start with
      <a href="/docs/acp/">Desktop Clients</a>. Headless jobs live in
      <a href="/docs/advanced/">Advanced</a>.
    </p>

    {
      overview && (
        <p class="mt-10">
          <a
            href={`/docs/${overview.id}/`}
            class="font-ui font-medium text-accent underline decoration-accent/35 underline-offset-[3px] hover:text-accent-hover"
          >
            Read the overview →
          </a>
        </p>
      )
    }
  </div>
</DocsLayout>
