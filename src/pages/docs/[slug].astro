---
import { statSync } from "node:fs";
import { join } from "node:path";
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH, SITE_URL, absoluteOgImageUrl } from "../../consts";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const all = await getCollection("docs");
const sorted = [...all].sort((a, b) => a.data.sidebarOrder - b.data.sidebarOrder);
const idx = sorted.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? sorted[idx - 1] : null;
const next = idx >= 0 && idx < sorted.length - 1 ? sorted[idx + 1] : null;

const pageTitle = `${entry.data.title} | nca AI coding CLI docs`;
const pageDesc =
  entry.data.description ??
  `${entry.data.title} documentation for nca, the Rust-native terminal AI coding agent.`;
const pageUrl = `${SITE_URL}/docs/${entry.id}/`;
const docFile = join(process.cwd(), "src/content/docs", `${entry.id}.md`);
const dateModified = statSync(docFile).mtime.toISOString();

const jsonLdExtra = [
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Documentation", item: `${SITE_URL}/docs/` },
      { "@type": "ListItem", position: 3, name: entry.data.title, item: pageUrl },
    ],
  },
  {
    "@type": "TechArticle",
    "@id": `${pageUrl}#article`,
    headline: entry.data.title,
    description: pageDesc,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    dateModified,
    inLanguage: "en",
    image: {
      "@type": "ImageObject",
      url: absoluteOgImageUrl(),
      width: OG_IMAGE_WIDTH,
      height: OG_IMAGE_HEIGHT,
    },
    author: {
      "@type": "Person",
      name: "Aris Setia",
      url: "https://github.com/madebyaris",
    },
    publisher: {
      "@type": "Organization",
      name: "nca",
      url: `${SITE_URL}/`,
    },
    about: { "@id": `${SITE_URL}/#app` },
  },
];
---

<DocsLayout
  title={pageTitle}
  description={pageDesc}
  entries={all}
  currentId={entry.id}
  sections={sections}
  ogType="article"
  jsonLdExtra={jsonLdExtra}
>
  <article class="prose-docs">
    <Content />
  </article>

  <nav
    class="font-ui mt-14 flex flex-col gap-4 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between"
    aria-label="Docs pagination"
  >
    {
      prev ? (
        <a href={`/docs/${prev.id}/`} class="text-sm text-fg-muted hover:text-accent-hover">
          <span class="block text-[11px] font-semibold uppercase tracking-[0.16em]">Previous</span>
          <span class="mt-1 block">{prev.data.title}</span>
        </a>
      ) : (
        <span></span>
      )
    }
    {
      next ? (
        <a href={`/docs/${next.id}/`} class="text-sm font-medium text-fg hover:text-accent-hover sm:text-right">
          <span class="block text-[11px] font-semibold uppercase tracking-[0.16em] text-accent">Next</span>
          <span class="mt-1 block">{next.data.title}</span>
        </a>
      ) : (
        <span></span>
      )
    }
  </nav>
</DocsLayout>
