---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const all = await getCollection("docs");

const pageTitle = `${entry.data.title} | nca docs`;
const pageDesc = entry.data.description ?? `Documentation: ${entry.data.title}`;
---

<DocsLayout title={pageTitle} description={pageDesc} entries={all} currentId={entry.id}>
  <article class="prose-docs font-body">
    <Content />
  </article>
</DocsLayout>
