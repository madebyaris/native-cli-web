---
import BaseLayout from "../layouts/BaseLayout.astro";

const platforms = [
  { name: "macOS (Apple Silicon)", target: "aarch64-apple-darwin" },
  { name: "macOS (Intel)", target: "x86_64-apple-darwin" },
  { name: "Linux (x86_64, glibc)", target: "x86_64-unknown-linux-gnu" },
  { name: "Linux (x86_64, static)", target: "x86_64-unknown-linux-musl" },
  { name: "Linux (ARM64)", target: "aarch64-unknown-linux-gnu" },
];
---

<BaseLayout
  title="Install nca | native-cli-ai"
  description="Install nca on macOS or Linux with one command, from GitHub Releases, or build from source."
>
  <!-- TopNavBar -->
  <nav class="fixed top-0 w-full z-50 bg-[#131313]/70 backdrop-blur-xl shadow-[0_0_20px_rgba(0,218,243,0.06)] border-b border-white/5">
    <div class="flex justify-between items-center max-w-7xl mx-auto px-6 py-4">
      <a href="/" class="text-xl font-black text-[#c3f5ff] tracking-tight font-headline">nca</a>
      <div class="hidden md:flex items-center space-x-8">
        <a class="text-[#bac9cc] hover:text-[#c3f5ff] transition-colors font-headline font-bold tracking-tighter text-sm" href="/#features">Features</a>
        <a class="text-[#bac9cc] hover:text-[#c3f5ff] transition-colors font-headline font-bold tracking-tighter text-sm" href="/#use-cases">Use Cases</a>
        <a class="text-[#c3f5ff] border-b-2 border-[#c3f5ff] pb-1 font-headline font-bold tracking-tighter text-sm" href="/get-started">Install</a>
        <a class="text-[#bac9cc] hover:text-[#c3f5ff] transition-colors font-headline font-bold tracking-tighter text-sm" href="https://github.com/madebyaris/native-cli-ai" target="_blank" rel="noreferrer">GitHub</a>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://github.com/madebyaris/native-cli-ai" target="_blank" rel="noreferrer" class="material-symbols-outlined text-[#c3f5ff] cursor-pointer hover:bg-[#2A2A2A]/50 p-2 rounded-full transition-all duration-300">terminal</a>
      </div>
    </div>
  </nav>

  <main class="relative overflow-hidden pt-32 pb-20">
    <div class="max-w-4xl mx-auto px-6">
      <!-- Page heading -->
      <div class="mb-16">
        <h1 class="text-5xl md:text-7xl font-black font-headline tracking-tighter leading-[0.9] mb-6 text-on-background">Install <span class="text-primary">nca</span></h1>
        <p class="text-on-surface-variant text-lg md:text-xl font-medium leading-relaxed max-w-2xl">
          One command on macOS and Linux. Detects your platform, downloads the latest release from GitHub, and installs to <code class="text-primary">/usr/local/bin</code>.
        </p>
      </div>

      <!-- One-line install -->
      <section class="mb-16">
        <h2 class="text-xs font-label uppercase tracking-widest text-primary mb-6">One-line install</h2>
        <div class="relative group">
          <div class="absolute -inset-1 bg-gradient-to-r from-primary to-secondary rounded-xl blur opacity-20 group-hover:opacity-80 transition duration-1000 group-hover:duration-200"></div>
          <div class="relative bg-black rounded-xl border border-white/10 p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
            <code class="text-lg md:text-2xl font-mono text-primary font-bold break-all">curl -fsSL https://nca-cli.com/install | bash</code>
            <button id="copy-install" class="bg-surface-container-highest hover:bg-surface-variant text-on-surface px-6 py-3 rounded-xl flex items-center gap-3 transition-colors border border-white/10 shrink-0">
              <span class="material-symbols-outlined">content_copy</span>
              <span class="font-label uppercase tracking-widest text-xs font-bold">Copy</span>
            </button>
          </div>
        </div>
        <p class="mt-4 text-on-surface-variant text-sm">Set <code class="text-primary">NCA_INSTALL_DIR</code> to change the install path from the default <code class="text-primary">/usr/local/bin</code>.</p>
      </section>

      <!-- GitHub Releases -->
      <section class="mb-16">
        <h2 class="text-xs font-label uppercase tracking-widest text-primary mb-6">GitHub Releases</h2>
        <p class="text-on-surface-variant text-sm mb-6">Pre-built binaries for every release are available on the <a href="https://github.com/madebyaris/native-cli-ai/releases" target="_blank" rel="noreferrer" class="text-primary hover:underline">Releases page</a>.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {platforms.map((p) => (
            <div class="bg-surface-container-low rounded-xl p-5 flex justify-between items-center border border-white/5 hover:bg-surface-container-high transition-all duration-200">
              <span class="text-on-surface font-headline font-bold text-sm">{p.name}</span>
              <code class="text-primary text-xs font-mono">{p.target}</code>
            </div>
          ))}
        </div>
      </section>

      <!-- Build from source -->
      <section class="mb-16">
        <h2 class="text-xs font-label uppercase tracking-widest text-primary mb-6">Build from source</h2>
        <p class="text-on-surface-variant text-sm mb-6">Requires Rust edition 2024 and a recent toolchain.</p>
        <div class="bg-surface-container-low rounded-xl border border-white/5 p-6 overflow-x-auto">
          <pre class="text-sm font-mono text-on-surface leading-relaxed"><span class="text-primary">$</span> git clone https://github.com/madebyaris/native-cli-ai.git
<span class="text-primary">$</span> cd native-cli-ai
<span class="text-primary">$</span> cargo build --release
<span class="text-primary">$</span> cp target/release/nca /usr/local/bin/</pre>
        </div>
      </section>

      <!-- Quick Start -->
      <section class="mb-16">
        <h2 class="text-xs font-label uppercase tracking-widest text-primary mb-6">Quick start</h2>
        <div class="bg-surface-container-low rounded-xl border border-white/5 p-6 overflow-x-auto">
          <pre class="text-sm font-mono text-on-surface leading-relaxed"><span class="text-on-surface-variant"># Configure a provider</span>
<span class="text-primary">$</span> export MINIMAX_API_KEY=<span class="text-secondary">"your-api-key"</span>

<span class="text-on-surface-variant"># Start the interactive CLI</span>
<span class="text-primary">$</span> nca

<span class="text-on-surface-variant"># Line REPL instead of the full-screen TUI</span>
<span class="text-primary">$</span> nca --no-tui

<span class="text-on-surface-variant"># Run one task and exit</span>
<span class="text-primary">$</span> nca run --prompt <span class="text-secondary">"Explain this repository"</span>

<span class="text-on-surface-variant"># Spawn a detached session</span>
<span class="text-primary">$</span> nca spawn --prompt <span class="text-secondary">"Inspect the repo and draft a plan"</span>

<span class="text-on-surface-variant"># Inspect and attach</span>
<span class="text-primary">$</span> nca sessions
<span class="text-primary">$</span> nca status &lt;session_id&gt;
<span class="text-primary">$</span> nca attach &lt;session_id&gt;</pre>
        </div>
      </section>

      <!-- Back to home -->
      <div class="text-center">
        <a href="/" class="text-primary font-label uppercase tracking-widest text-xs hover:underline">&larr; Back to home</a>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full py-12 border-t border-white/5 bg-[#000000]">
    <div class="max-w-7xl mx-auto px-8 flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="flex flex-col items-center md:items-start gap-4">
        <a href="/" class="text-lg font-bold text-[#c3f5ff]">nca</a>
        <p class="font-['Space_Grotesk'] uppercase text-[10px] tracking-widest text-[#bac9cc]/60">&copy; 2026 native-cli-ai by <a href="https://github.com/madebyaris" class="hover:text-[#d8b9ff] transition-colors">Aris Setia</a>. MIT License.</p>
      </div>
      <div class="flex gap-8">
        <a class="font-['Space_Grotesk'] uppercase text-[10px] tracking-widest text-[#bac9cc]/60 hover:text-[#d8b9ff] transition-colors" href="/get-started">Install</a>
        <a class="font-['Space_Grotesk'] uppercase text-[10px] tracking-widest text-[#bac9cc]/60 hover:text-[#d8b9ff] transition-colors" href="https://github.com/madebyaris/native-cli-ai" target="_blank" rel="noreferrer">GitHub</a>
        <a class="font-['Space_Grotesk'] uppercase text-[10px] tracking-widest text-[#bac9cc]/60 hover:text-[#d8b9ff] transition-colors" href="https://github.com/madebyaris" target="_blank" rel="noreferrer">Sponsor</a>
        <a class="font-['Space_Grotesk'] uppercase text-[10px] tracking-widest text-[#bac9cc]/60 hover:text-[#d8b9ff] transition-colors" href="https://github.com/madebyaris/native-cli-ai/releases" target="_blank" rel="noreferrer">Releases</a>
      </div>
    </div>
  </footer>

  <script>
    document.getElementById('copy-install')?.addEventListener('click', () => {
      navigator.clipboard.writeText('curl -fsSL https://nca-cli.com/install | bash');
      const btn = document.getElementById('copy-install');
      const label = btn?.querySelector('.font-label');
      if (label) {
        label.textContent = 'Copied!';
        setTimeout(() => { label.textContent = 'Copy'; }, 2000);
      }
    });
  </script>
</BaseLayout>