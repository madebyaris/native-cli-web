---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NcaTuiDemo from "../components/NcaTuiDemo.astro";
import CopyInstall from "../components/CopyInstall.astro";
import SessionLedger from "../components/SessionLedger.astro";
import { NCA_VERSION, GITHUB_REPO, SITE_DESCRIPTION } from "../consts";
---

<BaseLayout
  title="Terminal AI coding agent in 6 MB of RAM | nca"
  description={SITE_DESCRIPTION}
>
  <SiteHeader active="home" />

  <main id="main-content" class="flex-1">
    <section class="relative isolate overflow-hidden">
      <picture class="absolute inset-0 -z-10 block" aria-hidden="true">
        <source type="image/webp" srcset="/images/nca-pixel-night.webp" />
        <img
          src="/images/nca-pixel-night.jpg"
          alt="A pixel-art cabin with one lit window on a dark ridge, embers rising into fog"
          class="h-full w-full object-cover object-[30%_70%] [image-rendering:pixelated]"
          width="2560"
          height="1440"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-b from-page/50 via-transparent to-page"
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_50%_42%,rgb(16_17_15/0.78)_0%,rgb(16_17_15/0.4)_38%,transparent_70%)]"
        aria-hidden="true"
      ></div>
      <div class="mx-auto max-w-6xl px-4 pb-64 pt-16 text-center md:px-6 md:pb-80 md:pt-24">
        <p class="font-mono-article hero-animate mb-8 flex items-center justify-center gap-3 text-xs uppercase tracking-[0.18em] text-fg-muted">
          <span class="session-dot" aria-hidden="true"></span>
          session idle · ready for input
        </p>
        <h1
          class="font-display hero-animate hero-animate-delay-1 mx-auto max-w-4xl text-5xl font-normal leading-[0.95] tracking-[-0.05rem] text-fg text-balance md:text-7xl md:tracking-[-0.07rem]"
        >
          Terminal AI coding agent in <span class="text-accent">6 MB of RAM.</span>
        </h1>
        <p class="font-body hero-animate hero-animate-delay-2 mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted md:text-xl">
          nca is one Rust binary for the terminal. Start a job with <code class="font-mono-article text-[0.9em]">spawn</code>, keep working, then come back with <code class="font-mono-article text-[0.9em]">status</code>, <code class="font-mono-article text-[0.9em]">logs</code>, or <code class="font-mono-article text-[0.9em]">attach</code>.
        </p>
        <div class="hero-animate hero-animate-delay-3 mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/get-started/"
            class="font-ui rounded-md bg-accent px-6 py-3 text-sm font-semibold text-page transition-colors hover:bg-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Install nca
          </a>
          <a
            href="/docs/"
            class="font-ui text-sm font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:text-accent-hover"
          >
            Read the docs
          </a>
          <a
            href={GITHUB_REPO}
            class="font-ui text-sm font-medium text-fg-muted hover:text-accent-hover"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </div>
      </div>
    </section>

    <div class="relative z-10 mx-auto -mt-48 max-w-5xl px-4 md:-mt-64 md:px-6">
      <div class="hero-animate hero-animate-delay-3 shadow-[0_40px_120px_-30px_rgb(0_0_0/0.9)]">
        <NcaTuiDemo />
      </div>
    </div>

    <section id="sponsor" class="mx-auto mt-16 max-w-3xl px-4 text-center md:px-6" aria-labelledby="sponsor-heading">
      <h2 id="sponsor-heading" class="font-display text-2xl tracking-[-0.03rem] text-fg md:text-3xl">Our sponsor</h2>
      <ul class="mx-auto mt-8 grid max-w-xl grid-cols-3 gap-3 md:gap-4">
        <li class="flex h-20 items-center justify-center rounded-md bg-white p-4 md:h-24 md:p-6">
          <img src="/images/sponsors/kenari.png" alt="Kenari" width="107" height="43" class="max-h-10 w-auto max-w-full object-contain" loading="lazy" />
        </li>
        <li class="flex h-20 items-center justify-center rounded-md bg-white p-4 md:h-24 md:p-6">
          <img src="/images/sponsors/cursor.png" alt="Cursor" width="132" height="150" class="max-h-12 w-auto max-w-full object-contain" loading="lazy" />
        </li>
        <li class="flex h-20 items-center justify-center rounded-md bg-white p-4 md:h-24 md:p-6">
          <img src="/images/sponsors/minimax.webp" alt="MiniMax" width="349" height="128" class="max-h-10 w-auto max-w-full object-contain" loading="lazy" />
        </li>
      </ul>
    </section>

    <section
      id="release"
      class="mt-16 border-y border-border py-6"
      aria-label={`Release ${NCA_VERSION}`}
    >
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 md:flex-row md:items-center md:justify-between md:px-6">
        <p class="font-ui text-sm text-fg">
          <span class="font-medium">Latest release:</span> v{NCA_VERSION}. Desktop clients over ACP, context that fits, and fewer prompts.
        </p>
        <a
          href={`${GITHUB_REPO}/releases/tag/v${NCA_VERSION}`}
          class="font-ui text-sm font-medium text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover"
          target="_blank"
          rel="noopener noreferrer"
        >
          View release notes
        </a>
      </div>
      <p class="font-ui mx-auto mt-3 max-w-6xl px-4 text-sm leading-relaxed text-fg-muted md:px-6">
        <a
          href={`${GITHUB_REPO}#speed-and-memory`}
          class="underline decoration-fg-muted/40 underline-offset-4 hover:text-accent-hover"
          target="_blank"
          rel="noopener noreferrer"
          >6.4 MB</a
        > during one short reply, sampled before v0.5.0. On that run Grok CLI used 59 MB and Claude Code used 162 MB. v0.5.0 <code class="font-mono-article text-[0.9em]">doctor</code> peaks at 4.0 MB on this Mac, and that sample is startup only.
      </p>
    </section>

    <section id="workflows" class="border-b border-border py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-4 md:px-6">
        <h2 class="font-display max-w-2xl text-3xl tracking-[-0.03rem] text-fg text-balance md:text-4xl">How people use it</h2>
        <div class="mt-14 space-y-16">
          <div class="flex flex-col gap-6 md:flex-row md:items-start md:gap-16">
            <p class="font-ui w-40 shrink-0 text-xs font-medium uppercase tracking-widest text-fg-muted">Solo</p>
            <div class="min-w-0 max-w-3xl flex-1">
              <h3 class="font-display text-xl text-fg">Interactive TUI</h3>
              <p class="font-body mt-2 text-fg-muted">
                Full-screen transcript with markdown, live busy timers, slash commands, and a command palette. Use <kbd class="font-mono-article rounded bg-surface-400 px-1 text-[0.85em]">Tab</kbd> to cycle agents and <kbd class="font-mono-article rounded bg-surface-400 px-1 text-[0.85em]">Ctrl+P</kbd> to run commands.
              </p>
              <figure class="mt-6">
                <div
                  class="overflow-hidden border border-border bg-terminal-bg"
                >
                  <picture>
                    <source type="image/webp" srcset="/images/nca-tui-0.4.webp" />
                    <img
                      src="/images/nca-tui-0.4.jpg"
                      alt="nca full-screen TUI with transcript, context sidebar, status strip, and message composer"
                      class="block h-auto w-full"
                      width="1600"
                      height="809"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </div>
                <figcaption class="font-ui mt-3 text-xs text-fg-muted">Real TUI. Transcript, sidebar, and status strip.</figcaption>
              </figure>
            </div>
          </div>
          <div class="flex flex-col gap-6 md:flex-row md:items-start md:gap-16">
            <p class="font-ui w-40 shrink-0 text-xs font-medium uppercase tracking-widest text-fg-muted">Background</p>
            <div class="min-w-0 max-w-3xl flex-1">
              <h3 class="font-display text-xl text-fg">Spawn &amp; attach</h3>
              <p class="font-body mt-2 text-fg-muted">
                Kick off <code class="font-mono-article text-[0.9em]">nca spawn</code>, keep coding, then return with <code class="font-mono-article text-[0.9em]">status</code>, <code class="font-mono-article text-[0.9em]">logs</code>, or <code class="font-mono-article text-[0.9em]">attach</code>.
              </p>
              <div id="session-loop" class="mt-6 scroll-mt-24"><SessionLedger /></div>
            </div>
          </div>
          <div class="flex flex-col gap-6 md:flex-row md:items-start md:gap-16">
            <p class="font-ui w-40 shrink-0 text-xs font-medium uppercase tracking-widest text-fg-muted">Clients</p>
            <div>
              <h3 class="font-display text-xl text-fg">
                <a href="/docs/acp/" class="hover:text-accent-hover">Desktop clients</a>
              </h3>
              <p class="font-body mt-2 max-w-xl text-fg-muted">
                T3 Code, Termul, and Zed run nca with <code class="font-mono-article text-[0.9em]">nca acp</code>.&nbsp;<a href="/docs/advanced/" class="font-medium text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover">Headless jobs</a> still use <code class="font-mono-article text-[0.9em]">--json</code>, <code class="font-mono-article text-[0.9em]">--stream ndjson</code>, and <code class="font-mono-article text-[0.9em]">NCA_ORCH_*</code>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="border-b border-border py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-4 md:px-6">
        <h2 class="font-display max-w-2xl text-3xl tracking-[-0.03rem] text-fg text-balance md:text-4xl">
          Built for real terminal workflows
        </h2>
        <p class="font-body mt-4 max-w-2xl text-fg-muted">
          Sessions persist under your product home. Tools cover filesystem, search, shell, and web. Ordinary shell
          commands run without asking. nca still asks before a delete, sudo, or git push.
        </p>
        <ol class="mt-12 divide-y divide-border border-y border-border">
          <li class="grid gap-2 py-8 md:grid-cols-[5rem_1fr] md:gap-8">
            <p class="font-mono-article text-3xl leading-none text-fg/20">01</p>
            <div>
              <h3 class="font-display text-xl tracking-tight text-fg">
                <a href="/docs/sessions/" class="hover:text-accent-hover">Sessions &amp; IPC</a>
              </h3>
              <p class="font-body mt-2 max-w-2xl text-fg-muted">
                JSON snapshots and JSONL logs for every session. Resume them over IPC when you come back.
              </p>
            </div>
          </li>
          <li class="grid gap-2 py-8 md:grid-cols-[5rem_1fr] md:gap-8">
            <p class="font-mono-article text-3xl leading-none text-fg/20">02</p>
            <div>
              <h3 class="font-display text-xl tracking-tight text-fg">
                <a href="/docs/skills/" class="hover:text-accent-hover">Skills &amp; MCP</a>
              </h3>
              <p class="font-body mt-2 max-w-2xl text-fg-muted">
                Discover skills from <code class="font-mono-article text-[0.9em]">AGENTS.md</code>, workspace and user skill dirs, plus built-ins. MCP servers load from config so tools grow with your stack.
              </p>
            </div>
          </li>
          <li class="grid gap-2 py-8 md:grid-cols-[5rem_1fr] md:gap-8">
            <p class="font-mono-article text-3xl leading-none text-fg/20">03</p>
            <div>
              <h3 class="font-display text-xl tracking-tight text-fg">
                <a href="/docs/advanced/" class="hover:text-accent-hover">Subagents &amp; worktrees</a>
              </h3>
              <p class="font-body mt-2 max-w-2xl text-fg-muted">
                Spawn child agents with parent and child lineage, and optional isolated git worktrees for parallel work.
              </p>
            </div>
          </li>
          <li class="grid gap-2 py-8 md:grid-cols-[5rem_1fr] md:gap-8">
            <p class="font-mono-article text-3xl leading-none text-fg/20">04</p>
            <div>
              <h3 class="font-display text-xl tracking-tight text-fg">
                <a href="/docs/interactive-mode/" class="hover:text-accent-hover">Images in the TUI</a>
              </h3>
              <p class="font-body mt-2 max-w-2xl text-fg-muted">
                Paste images with <kbd class="font-mono-article rounded bg-surface-400 px-1 text-[0.85em]">Ctrl+V</kbd> or <code class="font-mono-article text-[0.9em]">/image</code>. The agent can show a picture back with <code class="font-mono-article text-[0.9em]">show_image</code>. If the model cannot see images, nca stops and says so.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="border-b border-border py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-4 md:px-6">
        <h2 class="font-display text-3xl tracking-[-0.03rem] text-fg text-balance md:text-4xl">Providers &amp; context</h2>
        <p class="font-body mt-4 max-w-2xl text-fg-muted">
          MiniMax-first with OpenAI, Anthropic, OpenRouter, and custom OpenAI/Anthropic-compatible endpoints. Config layers from defaults through <code class="font-mono-article text-[0.9em]">~/.local/share/ncacli/config.toml</code> and workspace overrides. Every provider request is fitted to the model window.
        </p>
        <div class="mt-10 max-w-xl border border-border bg-terminal-bg p-5">
          <p class="font-mono-article text-[12px] leading-relaxed text-fg md:text-[13px]" translate="no">
            <span class="text-accent">[memory.context]</span><br />
            context_window_target = 0<br />
            auto_summarize_threshold = 75<br />
            enable_auto_summarize = true<br />
            smart_compaction_mode = "on"
          </p>
        </div>
        <p class="font-ui mt-6 text-sm">
          <a href="/docs/providers/" class="font-medium text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover"
            >Provider setup</a
          >
          ·
          <a href="/docs/configuration/" class="font-medium text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover"
            >Configuration reference</a
          >
        </p>
      </div>
    </section>

    <section class="py-24 md:py-32">
      <div class="mx-auto max-w-3xl px-4 text-center md:px-6">
        <h2 class="font-display text-3xl tracking-[-0.03rem] text-fg text-balance md:text-4xl">Install in one command</h2>
        <p class="font-body mt-3 text-fg-muted">macOS and Linux. Downloads the latest release from GitHub.</p>
        <div class="mt-10 text-left">
          <CopyInstall />
        </div>
        <p class="font-ui mt-6 text-xs text-fg-muted">
          Apple Silicon &amp; Intel · Linux x86_64 &amp; ARM64 · Windows via GitHub Releases
        </p>
        <a
          href="/get-started/"
          class="font-ui mt-6 inline-block text-sm font-medium text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover"
        >
          All install options
        </a>
        <p class="font-body mt-8 text-fg-muted">
          nca is free under the MIT license and sponsored by Cursor, SpaceXAI, Kenari, and MiniMax. <a href="/support/" class="font-medium text-accent underline decoration-accent/35 underline-offset-4 hover:text-accent-hover">Support the work</a> if it earns a place in your shell.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
