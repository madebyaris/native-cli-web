---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { docGroups } from "../lib/doc-groups";
import type { CollectionEntry } from "astro:content";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  entries: CollectionEntry<"docs">[];
  /** Empty when on /docs hub — no sidebar item is marked active */
  currentId?: string;
  /** h2s for the current page. The hub has none. */
  sections?: Heading[];
  ogType?: "website" | "article";
  jsonLdExtra?: Record<string, unknown>[];
}

const { title, description, entries, currentId, sections = [], ogType = "website", jsonLdExtra } = Astro.props;

const sorted = [...entries].sort((a, b) => a.data.sidebarOrder - b.data.sidebarOrder);
const byId = new Map(sorted.map((entry) => [entry.id, entry]));
const used = new Set<string>();
const groups: { label: string; items: CollectionEntry<"docs">[] }[] = docGroups.map((group) => {
  const items = group.ids.flatMap((id) => {
    const entry = byId.get(id);
    if (!entry) return [];
    used.add(id);
    return [entry];
  });
  return { label: group.label, items };
});
const rest = sorted.filter((entry) => !used.has(entry.id));
if (rest.length > 0) groups.push({ label: "Also", items: rest });

const linkClass = (active: boolean) =>
  [
    "font-ui block px-2 py-1.5 text-sm",
    active
      ? "border-l-2 border-accent text-fg"
      : "border-l-2 border-transparent text-fg-muted hover:text-fg",
  ];
---

<BaseLayout title={title} description={description} ogType={ogType} jsonLdExtra={jsonLdExtra}>
  <SiteHeader active="docs" />

  <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-8 px-4 py-8 md:flex-row md:gap-10 md:px-6 md:py-12">
    <aside class="hidden md:block md:w-52 md:shrink-0">
      <nav class="md:sticky md:top-24" aria-label="Documentation sections">
        <p class="font-ui text-xs font-semibold uppercase tracking-[0.18em] text-fg-muted">Documentation</p>
        <a href="/docs" class:list={["mt-4", ...linkClass(!currentId)]}>All docs</a>
        {
          groups.map((group) => (
            <div class="mt-6">
              <p class="font-ui px-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-fg-muted">{group.label}</p>
              <div class="mt-1">
                {group.items.map((entry) => (
                  <a href={`/docs/${entry.id}`} class:list={linkClass(currentId === entry.id)}>
                    {entry.data.title}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </nav>
    </aside>

    <div class="min-w-0 flex-1 xl:grid xl:grid-cols-[minmax(0,1fr)_11rem] xl:items-start xl:gap-10">
      <main id="main-content" class="min-w-0 pb-12">
        <label class="font-ui mb-6 block text-sm md:hidden">
          <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-fg-muted">Documentation</span>
          <select
            id="docs-jump"
            class="w-full border border-border bg-page px-3 py-2.5 text-fg"
          >
            <option value="/docs" selected={!currentId}>All docs</option>
            {
              groups.map((group) => (
                <optgroup label={group.label}>
                  {group.items.map((entry) => (
                    <option value={`/docs/${entry.id}`} selected={currentId === entry.id}>
                      {entry.data.title}
                    </option>
                  ))}
                </optgroup>
              ))
            }
          </select>
        </label>

        {
          sections.length > 0 && (
            <nav class="mb-8 border border-border px-4 py-3 xl:hidden" aria-label="On this page">
              <p class="font-ui text-[11px] font-semibold uppercase tracking-[0.16em] text-fg-muted">On this page</p>
              <ul class="mt-2 space-y-1">
                {sections.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="font-ui text-sm text-fg-muted underline decoration-transparent underline-offset-4 hover:text-accent-hover hover:decoration-accent/40"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <slot />
      </main>

      {
        sections.length > 0 && (
          <nav class="sticky top-24 hidden xl:block" aria-label="On this page">
            <p class="font-ui text-[11px] font-semibold uppercase tracking-[0.16em] text-fg-muted">On this page</p>
            <ul class="mt-3 space-y-2 border-l border-border">
              {sections.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="font-ui block border-l-2 border-transparent py-0.5 pl-3 text-sm text-fg-muted hover:border-accent hover:text-fg"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </div>

  <SiteFooter />
</BaseLayout>

<script>
  const jump = document.getElementById("docs-jump");
  jump?.addEventListener("change", () => {
    if (jump instanceof HTMLSelectElement && jump.value) {
      window.location.href = jump.value;
    }
  });

  document.querySelectorAll(".prose-docs pre").forEach((pre) => {
    if (!(pre instanceof HTMLElement) || pre.closest(".code-block")) return;
    const wrap = document.createElement("div");
    wrap.className = "code-block";
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy code");
    wrap.appendChild(button);

    const setLabel = (text: string) => {
      button.textContent = text;
      button.setAttribute("aria-label", text === "Copy" ? "Copy code" : text);
    };

    button.addEventListener("click", async () => {
      const text = pre.innerText;
      try {
        await navigator.clipboard.writeText(text);
        setLabel("Copied");
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        setLabel("Selected");
      }
      window.setTimeout(() => setLabel("Copy"), 1500);
    });
  });
</script>
