---
import "../styles/global.css";
import {
  SITE_URL,
  SITE_DESCRIPTION,
  GITHUB_REPO,
  NCA_VERSION,
  absoluteOgImageUrl,
  OG_IMAGE_WIDTH,
  OG_IMAGE_HEIGHT,
} from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL for og:image (defaults to site OG asset) */
  ogImage?: string;
  ogType?: "website" | "article";
  /** Extra JSON-LD nodes merged into @graph (BreadcrumbList, TechArticle, etc.) */
  jsonLdExtra?: Record<string, unknown>[];
}

const title = Astro.props.title ?? "nca — Native CLI AI";
const description = Astro.props.description ?? SITE_DESCRIPTION;
const ogType = Astro.props.ogType ?? "website";
const ogImageUrl = Astro.props.ogImage ?? absoluteOgImageUrl();
const jsonLdExtra = Astro.props.jsonLdExtra ?? [];

const siteBase = Astro.site ?? new URL(SITE_URL);
const rawPath = Astro.url.pathname;
const pathname = rawPath === "/" || rawPath === "" ? "/" : rawPath.endsWith("/") ? rawPath : `${rawPath}/`;
const canonicalURL = new URL(pathname, siteBase).href;

const homeUrl = `${SITE_URL}/`;
const appId = `${SITE_URL}/#app`;

const softwareApp = {
  "@type": "SoftwareApplication",
  "@id": appId,
  name: "nca",
  alternateName: "Native CLI AI",
  description: SITE_DESCRIPTION,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  softwareVersion: NCA_VERSION,
  url: homeUrl,
  downloadUrl: `${SITE_URL}/get-started`,
  installUrl: `${SITE_URL}/install`,
  license: "https://opensource.org/licenses/MIT",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

const sourceCode = {
  "@type": "SoftwareSourceCode",
  "@id": `${SITE_URL}/#source`,
  name: "nca",
  codeRepository: GITHUB_REPO,
  programmingLanguage: "Rust",
  license: "https://opensource.org/licenses/MIT",
  targetProduct: { "@id": appId },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: "nca",
      url: homeUrl,
      logo: `${SITE_URL}/images/nca-robot.png`,
      sameAs: [GITHUB_REPO],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      name: "nca",
      alternateName: "Native CLI AI",
      url: homeUrl,
      description: SITE_DESCRIPTION,
      inLanguage: "en",
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
    softwareApp,
    sourceCode,
    ...jsonLdExtra,
  ],
};
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10110f" />
    <meta name="author" content="Aris Setia" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg?v=robot" type="image/svg+xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="nca" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content="nca — Native CLI AI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="nca — Native CLI AI" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Cloudflare Web Analytics: cookieless, no consent banner needed. -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "743fb3b8fe234287b43046c1a83c63cc"}'></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-83PM1L8JMX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-83PM1L8JMX");
    </script>
  </head>
  <body class="font-body selection:bg-surface-400 selection:text-fg text-fg flex min-h-screen flex-col">
    <div class="noise-overlay" aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
